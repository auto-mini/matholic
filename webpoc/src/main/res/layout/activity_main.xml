<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true"
    tools:ignore="MergeRootFrame">

    <WebView
        android:id="@+id/web_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAutofill="noExcludeDescendants"
        android:visibility="invisible" />

    <LinearLayout
        android:id="@+id/student_nav_bar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="top"
        android:background="#FF102A43"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="18dp"
        android:visibility="gone">

        <Button
            android:id="@+id/workbook_button"
            android:layout_width="200dp"
            android:layout_height="52dp"
            android:layout_marginEnd="10dp"
            android:backgroundTint="@color/student_section_background"
            android:text="학습지"
            android:textColor="@color/student_section_text"
            android:textSize="19sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/diagnostic_button"
            android:layout_width="200dp"
            android:layout_height="52dp"
            android:backgroundTint="@color/student_section_background"
            android:text="진단평가"
            android:textColor="@color/student_section_text"
            android:textSize="19sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/status_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="8dp"
        android:background="#E6102A43"
        android:paddingHorizontal="14dp"
        android:paddingVertical="7dp"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/finish_button"
        android:layout_width="180dp"
        android:layout_height="64dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="18dp"
        android:backgroundTint="#B71C1C"
        android:text="@string/finish_grading"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/result_summary_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF102A43"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="720dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="#FFFFFFFF"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="42dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="채점 결과"
                android:textColor="#102A43"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/wrong_answer_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:textColor="#102A43"
                android:textSize="28sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/result_continue_button"
                    android:layout_width="300dp"
                    android:layout_height="64dp"
                    android:backgroundTint="#1565C0"
                    android:text="다른 학습지 계속 채점"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/result_confirm_button"
                    android:layout_width="300dp"
                    android:layout_height="64dp"
                    android:layout_marginStart="14dp"
                    android:backgroundTint="#B71C1C"
                    android:text="확인하고 채점 끝내기"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/blocker"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF102A43"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp">

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:indeterminate="true" />

            <TextView
                android:id="@+id/blocker_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="@string/status_preparing"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/recovery_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/retry_safe_state"
                android:visibility="gone" />

            <Button
                android:id="@+id/gate3_abort_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/gate3_abort"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/setup_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F4F7FA"
        android:visibility="gone">

        <ScrollView
            android:layout_width="620dp"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingVertical="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:elevation="8dp"
                android:orientation="vertical"
                android:padding="30dp">

                <TextView
                    android:id="@+id/setup_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/setup_title"
                    android:textColor="#102A43"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/setup_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/setup_message"
                    android:textColor="#486581"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/gate3_account_a_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/gate3_account_a"
                    android:textColor="#102A43"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <EditText
                    android:id="@+id/expected_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/expected_name_hint"
                    android:importantForAutofill="no"
                    android:inputType="textPersonName|textNoSuggestions"
                    android:maxLines="1" />

                <EditText
                    android:id="@+id/username"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="@string/username_hint"
                    android:importantForAutofill="no"
                    android:inputType="text|textNoSuggestions"
                    android:maxLines="1" />

                <EditText
                    android:id="@+id/password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="@string/password_hint"
                    android:importantForAutofill="no"
                    android:inputType="textPassword"
                    android:maxLines="1" />

                <LinearLayout
                    android:id="@+id/gate3_account_b_panel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="@string/gate3_account_b"
                        android:textColor="#102A43"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/gate3_expected_name_b"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="@string/expected_name_hint"
                        android:importantForAutofill="no"
                        android:inputType="textPersonName|textNoSuggestions"
                        android:maxLines="1" />

                    <EditText
                        android:id="@+id/gate3_username_b"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:hint="@string/username_hint"
                        android:importantForAutofill="no"
                        android:inputType="text|textNoSuggestions"
                        android:maxLines="1" />

                    <EditText
                        android:id="@+id/gate3_password_b"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:hint="@string/password_hint"
                        android:importantForAutofill="no"
                        android:inputType="textPassword"
                        android:maxLines="1" />
                </LinearLayout>

                <TextView
                    android:id="@+id/setup_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="#B71C1C"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/gate3_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="#1B5E20"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/start_button"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="18dp"
                    android:backgroundTint="#1565C0"
                    android:text="@string/start_login"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/gate3_mode_button"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="#455A64"
                    android:text="@string/gate3_mode"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/gate3_start_button"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="18dp"
                    android:backgroundTint="#2E7D32"
                    android:text="@string/gate3_start"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/gate3_cancel_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/gate3_cancel"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/student_header_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="16dp"
        android:layout_marginTop="6dp"
        android:elevation="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/student_name_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#F2102A43"
            android:maxWidth="280dp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/student_help_button"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/student_help_button_background"
            android:contentDescription="현재 화면 도움말"
            android:filterTouchesWhenObscured="true"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_student_help" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/idle_warning_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6102A43"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="560dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="#FFFFFFFF"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="36dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="10분 동안 입력이 없었습니다"
                android:textColor="#102A43"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="답안은 그대로 유지됩니다. 계속하려면 아래 버튼을 누르세요."
                android:textColor="#486581"
                android:textSize="18sp" />

            <Button
                android:id="@+id/idle_continue_button"
                android:layout_width="280dp"
                android:layout_height="64dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="#1565C0"
                android:text="계속 채점"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/network_pause_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF102A43"
        android:clickable="true"
        android:focusable="true"
        android:importantForAccessibility="yes"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="36dp">

            <ProgressBar
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:indeterminate="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="인터넷 연결 복구를 기다리는 중입니다\n답안은 그대로 유지됩니다"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/student_help_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6102A43"
        android:clickable="true"
        android:focusable="true"
        android:importantForAccessibility="yes"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="860dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/student_help_card_background"
            android:elevation="24dp"
            android:orientation="vertical"
            android:padding="36dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/student_help_eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/student_help_eyebrow_background"
                    android:paddingHorizontal="15dp"
                    android:paddingVertical="7dp"
                    android:textColor="#FF0B5CAD"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/student_help_close_button"
                    android:layout_width="128dp"
                    android:layout_height="52dp"
                    android:backgroundTint="#FFE7EDF4"
                    android:contentDescription="도움말 닫기"
                    android:filterTouchesWhenObscured="true"
                    android:text="닫기"
                    android:textColor="#FF102A43"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/student_help_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:textColor="#FF102A43"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/student_help_lead"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="3dp"
                android:textColor="#FF486581"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/student_help_steps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:lineSpacingExtra="8dp"
                android:textColor="#FF102A43"
                android:textSize="21sp" />

            <TextView
                android:id="@+id/student_help_caution"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/student_help_caution_background"
                android:lineSpacingExtra="3dp"
                android:padding="18dp"
                android:textColor="#FF7A4500"
                android:textSize="19sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
