<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="#102A43"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="24dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="매쓰홀릭 QR 키오스크 · Gate 5"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/device_mode_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="28dp"
                android:text="전용기기 확인 중"
                android:textColor="#9FB3C8"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="준비 중"
                android:textColor="#D9EAF7"
                android:textSize="16sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/auth_panel"
                android:layout_width="480dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="#FFFFFF"
                android:elevation="8dp"
                android:orientation="vertical"
                android:padding="32dp">

                <TextView
                    android:id="@+id/auth_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="관리자 PIN 설정"
                    android:textColor="#102A43"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/auth_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="숫자 6~12자리 PIN을 기기 안에서 설정하세요."
                    android:textColor="#486581"
                    android:textSize="16sp" />

                <EditText
                    android:id="@+id/pin_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:hint="관리자 PIN"
                    android:importantForAutofill="no"
                    android:inputType="numberPassword"
                    android:maxLength="12"
                    android:saveEnabled="false" />

                <EditText
                    android:id="@+id/pin_confirm_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="PIN 확인"
                    android:importantForAutofill="no"
                    android:inputType="numberPassword"
                    android:maxLength="12"
                    android:saveEnabled="false" />

                <TextView
                    android:id="@+id/auth_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="#B00020"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/auth_submit"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="16dp"
                    android:text="설정" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/admin_panel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:padding="20dp"
                android:visibility="gone">

                <ScrollView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="20dp"
                    android:layout_weight="1.35"
                    android:fillViewport="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#FFFFFF"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="반 관리"
                            android:textColor="#102A43"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">

                            <EditText
                                android:id="@+id/class_name_input"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:hint="새 반 이름"
                                android:maxLength="40" />

                            <Button
                                android:id="@+id/create_class_button"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="반 생성" />
                        </LinearLayout>

                        <Spinner
                            android:id="@+id/class_spinner"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="8dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/manage_class_members_button"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="반 학생 구성" />

                            <Button
                                android:id="@+id/delete_class_button"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="선택한 반 삭제" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/class_roster_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="소속 학생 없음"
                            android:textColor="#486581"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:text="학생 관리"
                            android:textColor="#102A43"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/register_student_button"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="8dp"
                            android:text="새 학생 등록 및 QR 발급" />

                        <Spinner
                            android:id="@+id/student_spinner"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="8dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/reissue_qr_button"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="QR 폐기·재발급" />

                            <Button
                                android:id="@+id/update_profile_button"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="학생 이름 변경" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/update_credentials_button"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="로그인 정보 변경" />

                            <Button
                                android:id="@+id/deactivate_student_button"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="학생 비활성화" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:text="수업 준비"
                            android:textColor="#102A43"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/add_temporary_button"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="8dp"
                            android:text="이번 수업 보강 학생 선택" />

                        <Button
                            android:id="@+id/start_session_button"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="8dp"
                            android:text="선택한 반 수업 안전 시작" />

                        <Button
                            android:id="@+id/resume_session_button"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="8dp"
                            android:text="QR 대기 화면으로 복귀"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/admin_message"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:textColor="#334E68"
                            android:textSize="15sp" />
                    </LinearLayout>
                </ScrollView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.8"
                    android:background="#FFFFFF"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/qr_card_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="발급한 QR은 이 화면에 한 번만 표시됩니다"
                        android:textColor="#102A43"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/qr_image"
                        android:layout_width="360dp"
                        android:layout_height="360dp"
                        android:layout_marginTop="16dp"
                        android:contentDescription="발급된 학생 QR"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:text="화면 캡처·클립보드는 차단됩니다. 현재 표시 QR만 신뢰하는 Android 인쇄 서비스 또는 PDF 공유 대상으로 보낼 수 있습니다."
                        android:textColor="#627D98"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/print_qr_button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:enabled="false"
                        android:text="현재 표시 QR 인쇄" />

                    <Button
                        android:id="@+id/export_qr_pdf_button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:enabled="false"
                        android:text="카드 크기 PDF 공유·저장" />
                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:id="@+id/scanner_panel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#102A43">

                    <View
                        android:layout_width="260dp"
                        android:layout_height="260dp"
                        android:layout_gravity="center"
                        android:background="@drawable/qr_scan_target"
                        android:contentDescription="QR 카드를 맞추는 위치" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal|top"
                        android:layout_marginTop="52dp"
                        android:gravity="center"
                        android:text="카메라 영상은 표시하거나 저장하지 않습니다&#10;매쓰홀릭 QR이 사각형 안에 오도록 아래 안내를 따라주세요"
                        android:textColor="#D9E2EC"
                        android:textSize="18sp" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:background="#DD102A43"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/scanner_message"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="QR카드를 카메라에 보여주세요"
                        android:textColor="#FFFFFF"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/switch_camera_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:contentDescription="카메라 전환"
                        android:text="후면으로" />

                    <Button
                        android:id="@+id/session_admin_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="관리자" />
                </LinearLayout>
            </FrameLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
