<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/app_header"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="#102A43"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="24dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/header_title"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/device_mode_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="28dp"
                android:text="보안 확인 중"
                android:textColor="#9FB3C8"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/status_text"
                android:layout_width="240dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="end"
                android:maxLines="1"
                android:text="준비 중"
                android:textColor="#D9EAF7"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/remote_support_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:background="@drawable/remote_support_badge_background"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:text="원격 점검 중"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/auth_panel"
                android:layout_width="480dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="#FFFFFF"
                android:elevation="8dp"
                android:orientation="vertical"
                android:padding="32dp">

                <TextView
                    android:id="@+id/auth_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="관리자 PIN 설정"
                    android:textColor="#102A43"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/auth_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="숫자 6~12자리 PIN을 기기 안에서 설정하세요."
                    android:textColor="#486581"
                    android:textSize="16sp" />

                <EditText
                    android:id="@+id/pin_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:hint="관리자 PIN"
                    android:importantForAutofill="no"
                    android:inputType="numberPassword"
                    android:maxLength="12"
                    android:saveEnabled="false" />

                <EditText
                    android:id="@+id/pin_confirm_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="PIN 확인"
                    android:importantForAutofill="no"
                    android:inputType="numberPassword"
                    android:maxLength="12"
                    android:saveEnabled="false" />

                <TextView
                    android:id="@+id/auth_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="#B00020"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/auth_submit"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="16dp"
                    android:text="설정" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/admin_panel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:padding="20dp"
                android:visibility="gone">

                <ScrollView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="20dp"
                    android:layout_weight="1.35"
                    android:fillViewport="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#FFFFFF"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="반 관리"
                            android:textColor="#102A43"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/self_test_button"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="8dp"
                            android:text="운영 준비 자가진단" />

                        <Button
                            android:id="@+id/feedback_settings_button"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="8dp"
                            android:text="소리·진동 피드백 설정" />

                        <Button
                            android:id="@+id/keypad_layout_button"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="8dp"
                            android:text="수식 키패드 배치 설정" />

                        <Button
                            android:id="@+id/remote_support_button"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="8dp"
                            android:text="원격 점검 30분 시작" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">

                            <EditText
                                android:id="@+id/class_name_input"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:hint="새 반 이름"
                                android:maxLength="40" />

                            <Button
                                android:id="@+id/create_class_button"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="반 생성" />
                        </LinearLayout>

                        <Spinner
                            android:id="@+id/class_spinner"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="요일 반 빠른 선택"
                            android:textColor="#334E68"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <GridLayout
                            android:id="@+id/quick_class_grid"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:columnCount="6"
                            android:rowCount="2"
                            android:useDefaultMargins="true" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/manage_class_members_button"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="반 학생 구성" />

                            <Button
                                android:id="@+id/delete_class_button"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="선택한 반 삭제" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/class_roster_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="소속 학생 없음"
                            android:textColor="#486581"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:text="학생 관리"
                            android:textColor="#102A43"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/register_student_button"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="8dp"
                            android:text="새 학생 등록 및 QR 발급" />

                        <Button
                            android:id="@+id/import_student_csv_button"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="8dp"
                            android:text="지정 PC 학생 CSV 가져오기" />

                        <Spinner
                            android:id="@+id/student_spinner"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="8dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/reissue_qr_button"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="QR 폐기·재발급" />

                            <Button
                                android:id="@+id/update_profile_button"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="학생 이름 변경" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/update_credentials_button"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="로그인 정보 변경" />

                            <Button
                                android:id="@+id/deactivate_student_button"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="학생 비활성화" />
                        </LinearLayout>

                        <Button
                            android:id="@+id/reusable_cards_button"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="8dp"
                            android:text="신규용 카드 관리" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:text="수업 준비"
                            android:textColor="#102A43"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/add_temporary_button"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="8dp"
                            android:text="이번 수업 보강 학생 선택" />

                        <Button
                            android:id="@+id/start_session_button"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="8dp"
                            android:text="선택한 반 수업 안전 시작" />

                        <Button
                            android:id="@+id/resume_session_button"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="8dp"
                            android:text="QR 대기 화면으로 복귀"
                            android:visibility="gone" />

                        <Button
                            android:id="@+id/recover_session_button"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="8dp"
                            android:text="오류 상태 원버튼 복구"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/admin_message"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:textColor="#334E68"
                            android:textSize="15sp" />

                        <Button
                            android:id="@+id/undo_admin_button"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="8dp"
                            android:text="방금 작업 실행취소"
                            android:visibility="gone" />
                    </LinearLayout>
                </ScrollView>

                <ScrollView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.8"
                    android:background="#FFFFFF"
                    android:fillViewport="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:id="@+id/qr_card_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="발급한 QR은 이 화면에 한 번만 표시됩니다"
                            android:textColor="#102A43"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/qr_image"
                            android:layout_width="360dp"
                            android:layout_height="360dp"
                            android:layout_marginTop="16dp"
                            android:contentDescription="발급된 학생 QR"
                            android:scaleType="fitCenter" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center"
                            android:text="화면 캡처·클립보드는 차단됩니다. 현재 표시 QR은 PDF로 저장하거나 페어링된 지정 PC로만 보낼 수 있습니다."
                            android:textColor="#627D98"
                            android:textSize="14sp" />

                        <Button
                            android:id="@+id/export_qr_pdf_button"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:enabled="false"
                            android:text="카드 PDF Quick Share·저장" />

                        <Button
                            android:id="@+id/batch_qr_button"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="선택 반 QR 일괄 재발급·PC 전송" />

                        <Button
                            android:id="@+id/pending_cards_pdf_button"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="신규·변경 카드만 PC로 보내기" />

                        <Button
                            android:id="@+id/card_status_button"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="QR 카드 상태·이력" />

                        <Button
                            android:id="@+id/pair_pc_button"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="PC 무선 전송 페어링" />

                        <Button
                            android:id="@+id/send_pc_pdf_button"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:enabled="false"
                            android:text="현재 카드 지정 PC로 보내기" />
                    </LinearLayout>
                </ScrollView>
            </LinearLayout>

            <FrameLayout
                android:id="@+id/scanner_panel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#102A43">

                    <TextView
                        android:id="@+id/scanner_lens_pointer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical|start"
                        android:layout_margin="24dp"
                        android:translationY="11dp"
                        android:background="@drawable/scanner_lens_pointer_background"
                        android:contentDescription="왼쪽 전면 카메라 렌즈 위치"
                        android:gravity="center"
                        android:paddingHorizontal="18dp"
                        android:paddingVertical="12dp"
                        android:text="←  전면 카메라 렌즈"
                        android:textColor="#FFFFFFFF"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/scanner_center_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="32dp">

                        <TextView
                            android:id="@+id/scanner_lens_instruction"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="QR 카메라 사용 안내"
                            android:gravity="center"
                            android:maxWidth="700dp"
                            android:text="QR 카드를 전면 카메라 렌즈에 보여주세요"
                            android:textColor="#FFFFFF"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/scanner_message"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="28dp"
                            android:gravity="center"
                            android:minHeight="64dp"
                            android:textColor="#D9EAF7"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/cancel_qr_login_button"
                            android:layout_width="220dp"
                            android:layout_height="64dp"
                            android:layout_marginTop="18dp"
                            android:filterTouchesWhenObscured="true"
                            android:text="다른 카드"
                            android:textSize="20sp"
                            android:visibility="gone" />
                    </LinearLayout>
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/scanner_action_controls"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="20dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/switch_camera_button"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/scanner_icon_button_background"
                        android:contentDescription="후면 카메라로 전환"
                        android:padding="13dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_camera_switch"
                        app:tint="#FFFFFF" />

                    <ImageButton
                        android:id="@+id/session_admin_button"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/scanner_icon_button_background"
                        android:contentDescription="관리자 인증"
                        android:padding="13dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_admin_panel_settings"
                        app:tint="#FFFFFF" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/scanner_help_button"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="top|start"
                    android:layout_margin="20dp"
                    android:background="@drawable/student_help_button_background"
                    android:contentDescription="QR 카드 화면 도움말"
                    android:filterTouchesWhenObscured="true"
                    android:padding="11dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_student_help" />

                <FrameLayout
                    android:id="@+id/scanner_help_panel"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#E6102A43"
                    android:clickable="true"
                    android:focusable="true"
                    android:importantForAccessibility="yes"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="1180dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:background="@drawable/student_help_card_background"
                        android:elevation="24dp"
                        android:orientation="vertical"
                        android:padding="28dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/student_help_eyebrow_background"
                                android:paddingHorizontal="15dp"
                                android:paddingVertical="7dp"
                                android:text="QR 카드 인식"
                                android:textColor="#FF0B5CAD"
                                android:textSize="17sp"
                                android:textStyle="bold" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1" />

                            <Button
                                android:id="@+id/scanner_help_close_button"
                                android:layout_width="128dp"
                                android:layout_height="52dp"
                                android:backgroundTint="#FFE7EDF4"
                                android:contentDescription="도움말 닫기"
                                android:filterTouchesWhenObscured="true"
                                android:text="닫기"
                                android:textColor="#FF102A43"
                                android:textSize="18sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:baselineAligned="false"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="26dp"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:paddingTop="4dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="QR 카드로 내 이름을 확인하는 화면"
                                    android:textColor="#FF102A43"
                                    android:textSize="29sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp"
                                    android:lineSpacingExtra="2dp"
                                    android:text="코팅한 QR 명찰의 QR 면을 화면 가장자리의 실제 전면 카메라 렌즈에 보여주세요."
                                    android:textColor="#FF486581"
                                    android:textSize="19sp" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="20dp"
                                    android:lineSpacingExtra="7dp"
                                    android:text="1. 파란 화살표가 가리키는 실제 렌즈를 찾습니다.&#10;2. QR 면이 렌즈를 향하게 명찰을 듭니다.&#10;3. 렌즈에서 약 10~20cm 떨어진 곳부터 천천히 가까이 댑니다.&#10;4. 내 이름이 나오면 명찰을 내리고 잠시 기다립니다."
                                    android:textColor="#FF102A43"
                                    android:textSize="20sp" />

                                <TextView
                                    android:id="@+id/scanner_help_caution"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="20dp"
                                    android:background="@drawable/student_help_caution_background"
                                    android:lineSpacingExtra="2dp"
                                    android:padding="16dp"
                                    android:text="QR 명찰은 한 장만 보여주세요. 다른 이름이 나오거나 계속 인식되지 않으면 선생님을 불러주세요."
                                    android:textColor="#FF7A4500"
                                    android:textSize="18sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="500dp"
                                android:layout_height="wrap_content"
                                android:background="@drawable/student_help_simulation_background"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:padding="14dp">

                                <ImageView
                                    android:id="@+id/scanner_help_simulation"
                                    android:layout_width="472dp"
                                    android:layout_height="300dp"
                                    android:adjustViewBounds="true"
                                    android:contentDescription="학생이 코팅 QR 명찰을 태블릿 전면 카메라에 가져다 대는 예시"
                                    android:scaleType="fitCenter"
                                    android:src="@drawable/qr_badge_scan_simulation" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:gravity="center"
                                    android:text="QR 면을 렌즈 쪽으로 · 10~20cm에서 천천히 조절"
                                    android:textColor="#FF0B5CAD"
                                    android:textSize="17sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/scanner_remote_support_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="20dp"
                    android:background="@drawable/remote_support_badge_background"
                    android:elevation="32dp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:text="원격 점검 중"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </FrameLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
